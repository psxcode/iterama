{
  "name": "iterama",
  "version": "0.2.0",
  "description": "Composable functional Iterable<T> helpers",
  "keywords": [
    "functional",
    "generator",
    "iterable",
    "iterator",
    "lazy",
    "typescript"
  ],
  "homepage": "https://github.com/psxcode/iterama",
  "bugs": {
    "url": "https://github.com/psxcode/iterama/issues"
  },
  "license": "MIT",
  "author": "psxcode <psxcode@gmail.com> (https://github.com/psxcode)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psxcode/iterama.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test 'test/**/*.spec.ts'",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@11.19.1"
}
